{
  "name": "mason-forge-cloudflare-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test:connector": "node scripts/test-mcp-contract.mjs && node scripts/test-source-availability.mjs && node scripts/test-dashboard-auth.mjs",
    "test:extraction": "node scripts/test-extraction-classification.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute mason-forge-cloud --local --file schema/0001_initial.sql",
    "db:remote": "wrangler d1 execute mason-forge-cloud --remote --file schema/0001_initial.sql"
  },
  "devDependencies": {
    "wrangler": "^4.27.0"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.10.0",
    "pdf-lib": "^1.17.1"
  }
}
